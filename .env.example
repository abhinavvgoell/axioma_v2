DATABASE_URL=postgresql+psycopg://axioma:axioma@localhost:5432/axioma
JOB_EVENT_POLL_SECONDS=0.5

# Optional Gemma 4 code-review advisory via Google's Gemini API.
# Keep this key server-side; never put it in frontend/.env or commit it.
GEMINI_API_KEY=
# Supported models: gemma-4-26b-a4b-it or gemma-4-31b-it.
GEMMA_MODEL=gemma-4-26b-a4b-it

